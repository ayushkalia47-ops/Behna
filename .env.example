# Public site URL — used for canonical URLs, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://behnabikinis.com

# Waitlist: an endpoint that accepts POST { email } as JSON (e.g. a Klaviyo /
# Shopify Flow / Zapier / your own API route). Leave empty and the form will say
# signups are not open yet — nothing is stored.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

